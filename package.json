{
  "name": "citizen-hangar-pledge-sync",
  "description": "Citizen Hangar Pledge Sync extension",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/develop.cjs",
    "dev:firefox": "node scripts/develop.cjs -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "release:prepare": "wxt build && wxt build -b firefox && wxt zip && wxt zip -b firefox",
    "release:prepare:production": "node ./scripts/release-prepare-production.cjs",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "test:coverage:report": "c8 npm test",
    "test:coverage": "c8 --check-coverage npm test",
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "wxt": "^0.20.6"
  }
}
