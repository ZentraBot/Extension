{
  "all": true,
  "extension": [".ts", ".js", ".cjs"],
  "include": [
    "entrypoints/**/*.ts",
    ".coverage-compiled/**/*.js",
    "components/**/*.ts",
    "utils/**/*.ts",
    "wxt.config.ts",
    "scripts/**/*.cjs"
  ],
  "excludeAfterRemap": true,
  "reporter": ["text", "json-summary", "lcov"],
  "lines": 95,
  "functions": 95,
  "branches": 95,
  "statements": 95
}
